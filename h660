x,r,v=map(int,input().split())
n=int(input())
for i in range(n):
    p,s=map(int,input().split())#p位置s速度
    if abs(p-x) <=r: #有機會接球
       
        if s<=v:
            x=p#接球
        else:
            if p>=x:
                x=x-15
            else:
                x=x+15
                
        #閃躲
print(x)
