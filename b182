n,m=map(int,input().split())
a=[]#地圖
d=[(-1,-1),(-1,0),(-1,1),(0,-1),(0,0),(0,1),(1,-1),(1,0),(1,1)]
f=[(-2,-1),(-2,0),(-2,1),(-1,-2),(-1,-1),(-1,0),(-1,1),(-1,2),(0,-2),(0,-1),(0,0),(0,1),(0,2),(1,-2),(1,-1),(1,0),(1,1),(1,2),(2,-1),(2,0),(2,1)]
for i in range(n):
    b=[0 for j in range(n)]
    a.append(b)
for i in range(m):
    x,y=map(int,input().split())#建築物的中心
    x,y=x-1,y-1
    for k in d:
        x0,y0=x,y
        x0+=k[0]
        y0+=k[1]
        if 0<=x0<=n-1 and 0<=y0<=n-1:
            a[x0][y0]=i+1
ans=0
for x in range(n):
    for y in range(n):
        o=[]
        for k in f:
            x0,y0=x,y
            x0 +=k[0]
            y0 +=k[1]                                 
            if 0<=x0<=n-1 and 0<=y0<=n-1:
                if a[x0][y0] !=0:
                    if a[x0][y0] not in o:
                        o.append(a[x0][y0])
                        
        if len(o)> ans:
            ans=len(o)
print(ans)
