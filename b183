n,m=map(int,input().split())
a=[]#轉換過的矩陣
for i in range(n):
    b=list(map(int,input().split()))
    a.append(b)
c=[]#搜尋中心的矩陣
for i in range(n):
    b=list(map(int,input().split()))
    c.append(b)
d=[]
for i in range(n):
    b=[0 for j in range(m)]
    d.append(b)
for i in range(n):
    for j in range(m):
        if c[i][j]==1:#搜尋中心
            if i ==0 or i==n-1 :
                d[i][j] =int((a[i][j]-1)/2)
            else:
                d[i][j] =int(a[i][j]/2)
        else:#非搜尋中心
            if i==0 or i==n-1:
                d[i][j]=a[i][j]-1
            else:
                d[i][j]=a[i][j]
for i in range(n):
    for j in range(m):
        print(d[i][j],end=" ")
    print()
